{
  "$defs": {
    "Cadence": {
      "additionalProperties": false,
      "description": "Count per period, or `none` (one-off).\n\nThis is a count over a period, not fixed weekdays (Q26).\nDaily-ish is modelled as count=1, period=day \u2014 no extra flag.",
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "period": {
          "default": "none",
          "enum": [
            "day",
            "week",
            "none"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "title": "Cadence",
      "type": "object"
    },
    "SubjectStatus": {
      "enum": [
        "active",
        "shrunk",
        "paused",
        "retired"
      ],
      "title": "SubjectStatus",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "title": "Current",
          "type": "integer"
        },
        "goal": {
          "title": "Goal",
          "type": "integer"
        }
      },
      "required": [
        "current",
        "goal"
      ],
      "title": "Target",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "When the practice can still happen.\n\n`hours` are the stated hours, ordered and without repeats \u2014 one window may\nhold several ([07](../../../docs/rfc/07-open-questions.md) Q34): \u00ab\u0432 10, 12,\n15, 16:30, 18, 21, 22\u00bb is one practice firing seven times, not seven events\nwith lives of their own. Nothing invents an hour nobody said.\n\n`latest_by` is the first of them, kept as a real field so a desk and a wire\nwritten before Q34 still open and still read: one hour is a legal window and\nalways was.\n\n`closes_at` is the optional source fact (gym door). If no hour was stated,\nlatest_by = closes_at minus 3 hours (22:00 \u2192 19:00). A stated hour wins; do\nnot replace 19:00 with 23:00 \u2212 3h = 20:00.",
      "properties": {
        "hours": {
          "items": {
            "format": "time",
            "type": "string"
          },
          "title": "Hours",
          "type": "array"
        },
        "latest_by": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest By"
        },
        "closes_at": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closes At"
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "cadence": {
      "$ref": "#/$defs/Cadence"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/Window"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cue Ids",
      "type": "array"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "instance_ids": {
      "items": {
        "type": "string"
      },
      "title": "Instance Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SubjectStatus",
      "default": "active"
    },
    "paused_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paused At"
    },
    "drift_asks_made": {
      "default": 0,
      "minimum": 0,
      "title": "Drift Asks Made",
      "type": "integer"
    },
    "drift_retire_refusals": {
      "default": 0,
      "minimum": 0,
      "title": "Drift Retire Refusals",
      "type": "integer"
    },
    "drift_asked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drift Asked At"
    }
  },
  "required": [
    "id",
    "title",
    "cadence"
  ],
  "title": "Subject",
  "type": "object"
}
