        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "tile_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile Size"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
