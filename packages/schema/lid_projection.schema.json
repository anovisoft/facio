        "payload": {
          "$ref": "#/$defs/WidgetPayload"
        },
        "status": {
          "$ref": "#/$defs/WidgetStatus"
        },
        "when": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "section": {
          "$ref": "#/$defs/WidgetSection"
