{
  "$defs": {
    "DriftCard": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "silent_days": {
          "title": "Silent Days",
          "type": "integer"
        },
        "offer": {
          "$ref": "#/$defs/DriftOffer"
        }
      },
      "required": [
        "subject_id",
        "silent_days",
        "offer"
      ],
      "title": "DriftCard",
      "type": "object"
    },
    "DriftOffer": {
      "enum": [
        "move_to_today",
        "once_a_week",
        "retire",
        "stop"
      ],
      "title": "DriftOffer",
      "type": "string"
    },
    "DriftTodayItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "drift",
          "default": "drift",
          "title": "Kind",
          "type": "string"
        },
        "band": {
          "const": "drift_card",
          "default": "drift_card",
          "title": "Band",
          "type": "string"
        },
        "drift_card": {
          "$ref": "#/$defs/DriftCard"
        }
      },
      "required": [
        "drift_card"
      ],
      "title": "DriftTodayItem",
      "type": "object"
    },
    "RankBand": {
      "enum": [
        "in_progress",
        "overdue",
        "unanswered_morning",
        "drift_card",
        "soon_by_time",
        "today_incomplete"
      ],
      "title": "RankBand",
      "type": "string"
    },
    "Widget": {
