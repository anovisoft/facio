  "additionalProperties": false,
  "description": "The lid is a view of what is due now, not a second inventory.",
  "properties": {
    "today": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/WidgetTodayItem"
          },
          {
            "$ref": "#/$defs/DriftTodayItem"
          }
        ]
      },
      "title": "Today",
      "type": "array"
    },
    "lifetime": {
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "title": "Lifetime",
      "type": "array"
    },
    "soon": {
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "title": "Soon",
      "type": "array"
    },
    "postponed": {
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "title": "Postponed",
      "type": "array"
    },
    "drift_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/DriftCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "today",
    "lifetime",
    "soon",
    "postponed"
  ],
  "title": "LidProjection",
  "type": "object"
}
