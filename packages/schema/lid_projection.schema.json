      "required": [
        "id",
        "type",
        "title",
        "status",
        "section",
        "subject_id",
        "instance_id"
      ],
      "title": "Widget",
      "type": "object"
    },
    "WidgetPayload": {
      "additionalProperties": true,
      "description": "Flexible payload; fields used by tests are typed, the rest may pass through.",
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
