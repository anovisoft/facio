        },
        "steps": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "current": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "fire_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fire At"
        }
      },
      "title": "WidgetPayload",
      "type": "object"
    },
    "WidgetSection": {
      "enum": [
        "today",
        "lifetime",
        "soon",
        "postponed"
      ],
      "title": "WidgetSection",
      "type": "string"
    },
    "WidgetStatus": {
      "enum": [
        "ready",
        "running",
        "done",
        "skipped",
        "snoozed",
        "archived"
      ],
      "title": "WidgetStatus",
      "type": "string"
    },
    "WidgetTodayItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "widget",
          "default": "widget",
          "title": "Kind",
          "type": "string"
        },
        "band": {
          "$ref": "#/$defs/RankBand"
        },
        "widget": {
          "$ref": "#/$defs/Widget"
        }
      },
      "required": [
        "band",
        "widget"
      ],
      "title": "WidgetTodayItem",
      "type": "object"
    },
    "WidgetType": {
      "enum": [
        "counter",
        "tick",
        "checklist",
        "reminder",
        "timer",
        "stepper"
      ],
      "title": "WidgetType",
      "type": "string"
    }
