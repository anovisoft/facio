{
  "$defs": {
    "ChecklistItem": {
      "additionalProperties": false,
      "description": "One line of a checklist.\n\n`done` is finger state on that line, nothing more: no per-item timestamp,\nno score. Progress over the list is arithmetic in `runtime.py`, so the\npayload never carries a \"progress\" number of its own \u2014 a stored count and\na list of ticks are two truths about the same thing, and they drift.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "WidgetPayload": {
      "additionalProperties": true,
      "description": "What a runtime needs to run. Extra keys still pass through.\n\nThe typed part is the catalog (Q1): `count`/`target` for the counter,\n`done` for the tick, `fire_at` for the reminder, `items` for the checklist,\n`seconds`/`started_at`/`elapsed` for the timer, `beats`/`current` for the\nstepper. Anything the model invents on top stays in `extra` and no runtime\nreads it (never-do AI #1).",
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "done": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ChecklistItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "elapsed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed"
        },
        "beats": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beats"
        },
        "current": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "fire_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fire At"
        }
      },
      "title": "WidgetPayload",
      "type": "object"
    },
    "WidgetSection": {
      "enum": [
        "today",
        "lifetime",
        "soon",
        "postponed"
      ],
      "title": "WidgetSection",
      "type": "string"
    },
    "WidgetStatus": {
      "enum": [
        "ready",
        "running",
        "done",
        "skipped",
        "snoozed",
        "archived"
      ],
      "title": "WidgetStatus",
      "type": "string"
    },
    "WidgetType": {
      "enum": [
        "counter",
        "tick",
        "checklist",
        "reminder",
        "timer",
        "stepper"
      ],
      "title": "WidgetType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/WidgetType"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/WidgetPayload"
    },
    "status": {
      "$ref": "#/$defs/WidgetStatus"
    },
    "when": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "When"
    },
    "section": {
      "$ref": "#/$defs/WidgetSection"
    },
    "group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Id"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "instance_id": {
      "title": "Instance Id",
      "type": "string"
    },
    "tile_size": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tile Size"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "status",
    "section",
    "subject_id",
    "instance_id"
  ],
  "title": "Widget",
  "type": "object"
}
