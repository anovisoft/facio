FASIO_POSTGRES_USER=fasio
FASIO_POSTGRES_PASSWORD=fasio
FASIO_POSTGRES_DB=fasio
FASIO_APP_NAME=Facio API
FASIO_DEBUG=false
# Comma-separated origins. "*" disables credentials (browser-safe).
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Used when running the API outside Docker against compose Postgres:
# DATABASE_URL=postgresql+asyncpg://fasio:fasio@localhost:5435/fasio
