{
  "name": "mobapp-rn",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true EXPO_XCODEBUILD_ARGUMENTS='-allowProvisioningUpdates' expo run:ios",
    "ios:default": "SENTRY_DISABLE_AUTO_UPLOAD=true EXPO_XCODEBUILD_ARGUMENTS='-allowProvisioningUpdates' expo run:ios --device '00008130-00022C1E1A8B803A'",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "web": "expo start --web"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~7.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sortables": "^1.10.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
