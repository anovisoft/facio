{
  "id": "timer_meditation_en",
  "utterance": "meditate 10 minutes every day",
  "match": ["meditate 10 minutes"],
  "scripted": [
    {
      "tool_calls": [
        {
          "name": "create_widget",
          "arguments": {
            "type": "timer",
            "title": "meditation",
            "subject_id": "meditation",
            "cadence": {
              "count": 1,
              "period": "day"
            },
            "seconds": 600
          }
        },
        {
          "name": "add_cue",
          "arguments": {
            "subject_id": "meditation",
            "kind": "correction",
            "surface": "do-time",
            "text": "sit upright, breathe through the nose"
          }
        }
      ]
    },
    {
      "text": "Ten minutes a day, the timer is on the desk. Morning or evening?"
    }
  ],
  "expect": {
    "mutated": true,
    "tools": ["create_widget", "add_cue"],
    "forbidden_tools": ["set_reminder"],
    "cadence": {
      "count": 1,
      "period": "day"
    },
    "cue": {
      "subject_id": "meditation",
      "surface": "do-time",
      "kind": "correction",
      "text_contains": ["breathe through the nose"]
    }
  }
}
