{
  "id": "stepper_warmup_en",
  "utterance": "walk me through the warm-up step by step, twice a week",
  "match": ["warm-up step by step"],
  "scripted": [
    {
      "tool_calls": [
        {
          "name": "create_widget",
          "arguments": {
            "type": "stepper",
            "title": "warm-up",
            "subject_id": "warmup",
            "cadence": {
              "count": 2,
              "period": "week"
            },
            "beats": [
              "joint circles",
              "5 minutes on the bike",
              "two sets with no weight"
            ]
          }
        },
        {
          "name": "add_cue",
          "arguments": {
            "subject_id": "warmup",
            "kind": "correction",
            "surface": "do-time",
            "text": "do not pull anything cold"
          }
        }
      ]
    },
    {
      "text": "Three beats, twice a week. Reorder them or add one?"
    }
  ],
  "expect": {
    "mutated": true,
    "tools": ["create_widget", "add_cue"],
    "forbidden_tools": ["set_reminder"],
    "cadence": {
      "count": 2,
      "period": "week"
    },
    "cue": {
      "subject_id": "warmup",
      "surface": "do-time",
      "kind": "correction",
      "text_contains": ["cold"]
    }
  }
}
