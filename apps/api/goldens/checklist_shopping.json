{
  "id": "checklist_shopping",
  "utterance": "список покупок на неделю: хлеб, молоко, яблоки",
  "match": ["список покупок"],
  "scripted": [
    {
      "tool_calls": [
        {
          "name": "create_widget",
          "arguments": {
            "type": "checklist",
            "title": "продукты",
            "subject_id": "groceries",
            "cadence": {
              "count": 1,
              "period": "week"
            },
            "items": ["хлеб", "молоко", "яблоки"]
          }
        },
        {
          "name": "add_cue",
          "arguments": {
            "subject_id": "groceries",
            "kind": "correction",
            "surface": "do-time",
            "text": "иди после работы, не голодным"
          }
        }
      ]
    },
    {
      "text": "Список на столе, раз в неделю. Дописать что-то ещё?"
    }
  ],
  "expect": {
    "mutated": true,
    "tools": ["create_widget", "add_cue"],
    "forbidden_tools": ["set_reminder"],
    "cadence": {
      "count": 1,
      "period": "week"
    },
    "cue": {
      "subject_id": "groceries",
      "surface": "do-time",
      "kind": "correction",
      "text_contains": ["после работы"]
    }
  }
}
