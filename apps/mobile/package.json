{
  "name": "facio",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "EXPO_XCODEBUILD_ARGUMENTS='-allowProvisioningUpdates' expo run:ios",
    "ios:default": "SENTRY_DISABLE_AUTO_UPLOAD=true EXPO_XCODEBUILD_ARGUMENTS='-allowProvisioningUpdates' expo run:ios --device '00008130-00022C1E1A8B803A'",
    "android": "expo run:android",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~54.0.35",
    "expo-crypto": "~15.0.9",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
